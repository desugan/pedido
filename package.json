{
  "name": "pedido-workspace",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const{spawn}=require('child_process');const fs=require('fs');const b=spawn(fs.existsSync('api/.venv/bin/python')?'api/.venv/bin/python':'python',['api/run.py'],{stdio:'inherit'});const f=spawn('npm',['--prefix','web','run','dev'],{stdio:'inherit'});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()})\"",
    "dev:backend": "python api/run.py",
    "dev:frontend": "npm --prefix web run dev",
    "build": "npm --prefix web run build"
  },
  "keywords": ["pedidos", "api", "flask"],
  "license": "MIT"
}
